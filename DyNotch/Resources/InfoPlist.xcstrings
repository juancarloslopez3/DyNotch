{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAudioCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch listens to what's playing so the bars beside the notch move with the music. Nothing is recorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch escucha lo que suena para que las barras junto al notch se muevan con la música. No se graba nada."
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch shows when Bluetooth devices like AirPods connect, along with their battery level."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch muestra cuándo se conectan dispositivos Bluetooth como los AirPods, junto con su nivel de batería."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch shows your upcoming events in the notch and offers a Join button for online meetings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch muestra tus próximos eventos en el notch y ofrece un botón Unirse para las reuniones en línea."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch shows a camera mirror so you can check how you look before a call. Video never leaves your Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch muestra un espejo de cámara para que veas qué aspecto tienes antes de una llamada. El vídeo nunca sale de tu Mac."
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch uses your approximate location to show the local weather."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch usa tu ubicación aproximada para mostrar el tiempo local."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch uses your approximate location to show the local weather."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch usa tu ubicación aproximada para mostrar el tiempo local."
          }
        }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch shows today's reminders in the notch and lets you tick them off."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "DyNotch muestra los recordatorios de hoy en el notch y te deja marcarlos."
          }
        }
      }
    }
  },
  "version" : "1.0"
