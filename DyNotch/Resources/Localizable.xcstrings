            "value" : "Todo listo"
          }
        }
      }
    },
    "Your notch becomes a Dynamic Island, with your music, calendar, weather, timers, a shelf for files and the volume, all in Liquid Glass that blends into the hardware." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu notch se convierte en una Dynamic Island, con tu música, el calendario, el tiempo, temporizadores, un estante para archivos y el volumen, todo en Liquid Glass que se funde con el hardware."
          }
        }
      }
    },
    "Your timer finished" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha terminado tu temporizador"
          }
        }
      }
    },
    "Zoom, Meet, Teams, Webex and FaceTime links in events pop up with Join 5 minutes before and when they start." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
