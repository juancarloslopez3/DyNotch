// Code signing for local builds.
//
// By default DyNotch is signed ad-hoc ("Sign to Run Locally"). macOS then forgets
// privacy permissions (Accessibility, Camera, ...) every time the app is rebuilt.
// To keep them, add your (free) Apple ID in Xcode > Settings > Accounts and create
// Config/Signing.local.xcconfig (git-ignored) containing:
//
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
